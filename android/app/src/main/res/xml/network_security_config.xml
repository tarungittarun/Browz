<?xml version="1.0" encoding="utf-8"?>
<!-- Defence in depth: no cleartext anywhere, system trust anchors only,
     and no user-installed CA is trusted for app traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
